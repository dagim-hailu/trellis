# Shared infrastructure. Copy to .env at the repository root.
NODE_ENV=development

# Local docker-compose maps PostgreSQL and Redis to non-default host ports.
DATABASE_URL=postgresql://trellis:trellis_dev_password@127.0.0.1:55432/trellis
REDIS_URL=redis://127.0.0.1:56379

# 32+ random bytes. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=izluCIdk5tKJqMjMHT55hTeOYfkRBdnvi5S2b5nlEo4
JWT_ISSUER=trellis-api
JWT_AUDIENCE=trellis-clients
ACCESS_TOKEN_TTL_SECONDS=3600

API_HOST=127.0.0.1
API_PORT=4400
REALTIME_HOST=127.0.0.1
REALTIME_PORT=4401
WEB_ORIGIN=http://localhost:3100

# Realtime fan-out and persistence tuning.
REDIS_CHANNEL_PREFIX=trellis
SNAPSHOT_EVERY_UPDATES=200
SNAPSHOT_INTERVAL_MS=60000
SNAPSHOT_RETENTION=5
MAX_UPDATE_BYTES=1048576
AUTH_TIMEOUT_MS=5000

# Browser-visible endpoints. Also copy into apps/web/.env.local when you
# want a build-time override; the defaults in apps/web/src/lib/env.ts match
# the local development ports above.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4400
NEXT_PUBLIC_REALTIME_URL=ws://127.0.0.1:4401
